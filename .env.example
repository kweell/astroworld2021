# local: embedded PostgreSQL, no credentials. supabase: hosted PostgreSQL.
DATABASE_MODE=local
LOCAL_DATABASE_PATH=.data/postgres
DEMO_AUTH_MODE=true
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
# Required when DATABASE_MODE=supabase. Use the Session pooler (5432) or direct URL.
SUPABASE_DB_URL=
# Required for Supabase bearer-token authentication when DEMO_AUTH_MODE=false.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase's public CA certificate, bundled for verified database TLS.
# Replace this path if your project requires a different CA certificate.
SUPABASE_DB_CA_PATH=supabase/certs/prod-ca-2021.crt
